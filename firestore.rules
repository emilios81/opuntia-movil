rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * OPUNTIACOLOR SECURITY RULES (PROTOTYPE MODE)
     *
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model designed for archaeological field work. 
     * Security is anchored to the user's authenticated UID, ensuring that researchers maintain 
     * exclusive control over their projects, raw imagery, and analysis results.
     *
     * Data Structure:
     * The database follows a hierarchical user-centric organization:
     * /users/{userId}/projects/{projectId}
     *   -> /images/{imageId}
     *     -> /analysisResults/{analysisResultId}
     *
     * Key Security Decisions:
     * 1. Authorization Independence: To optimize performance and avoid costly get() calls, 
     *    relational data like project ownership is validated against the path parameters.
     * 2. Denormalization for Security: While the schema is flexible for prototyping, 
     *    relational fields (like userId or projectId) are strictly validated on creation 
     *    and enforced as immutable during updates to prevent data orphaned from its owner.
     * 3. Ownership-Based Access: No public reading or writing is permitted. Every request 
     *    must be authenticated and must target the user's own data branch.
     * 4. State Verification: All update and delete operations require a pre-condition 
     *    check to ensure the resource exists and belongs to the requester.
     */

    // --- HELPER FUNCTIONS ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user matches the provided userId from the path. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Combines ownership check with document existence for destructive operations. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for archaeological projects. Each project is tied to a specific researcher.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create) if authenticated UID matches {userId} and data.userId matches {userId}.
     * @deny (create) if user attempts to create a project in another user's path.
     * @principle Ownership-based access with path-to-field consistency validation.
     */
    match /users/{userId}/projects/{projectId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for original rock art images within a project.
       * @path /users/{userId}/projects/{projectId}/images/{imageId}
       * @allow (get) if the user is the owner of the project branch.
       * @deny (list) if the userId in the path does not match the requester's UID.
       * @principle Relational integrity; ensures images are correctly linked to their parent project.
       */
      match /images/{imageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.projectId == projectId;
        allow update: if isExistingOwner(userId) && request.resource.data.projectId == resource.data.projectId;
        allow delete: if isExistingOwner(userId);

        /**
         * @description Rules for image enhancement results (LAB/YCbCr/Jacobi analyses).
         * @path /users/{userId}/projects/{projectId}/images/{imageId}/analysisResults/{analysisResultId}
         * @allow (update) if the owner is the same and the parent image link is unchanged.
         * @deny (delete) if the document does not exist or belongs to another user.
         * @principle Deeply nested ownership verification without cross-document lookups.
         */
        match /analysisResults/{analysisResultId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.imageId == imageId;
          allow update: if isExistingOwner(userId) && request.resource.data.imageId == resource.data.imageId;
          allow delete: if isExistingOwner(userId);
        }
      }
    }
  }
}